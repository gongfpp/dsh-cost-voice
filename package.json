{
  "name": "dsh-cost-voice",
  "version": "1.0.1",
  "description": "每轮会话结束后用支付宝或大白饭的声音播报本轮花费；金额优先取 dsh-cost-meter，否则按该轮模型单价估算。Per-turn spend voice announcements for DeepSeek Harness with Alipay or Dabaifan voice packs.",
  "type": "module",
  "license": "MIT",
  "author": "gongfpp",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "tts",
    "voice",
    "cost",
    "billing",
    "alipay"
  ],
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0-0",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/voices/**/*.mp3",
    "assets/pricing.json",
    "docs/preview-settings.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.1-0 <0.3.0-0"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-cost-voice",
    "summary": "每轮结束用支付宝或大白饭语音播报本轮花费；金额优先取 dsh-cost-meter，否则按该轮模型单价估算，语音为内置音频片段，无需联网。",
    "categories": [
      "usage",
      "voice"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {},
    "compatibility": {
      "dsh": ">=0.2.1-0 <0.3.0-0",
      "node": ">=22"
    },
    "permissions": {}
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongfpp/dsh-cost-voice.git"
  },
  "homepage": "https://github.com/gongfpp/dsh-cost-voice#readme",
  "bugs": {
    "url": "https://github.com/gongfpp/dsh-cost-voice/issues"
  }
}

