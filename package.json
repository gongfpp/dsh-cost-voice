{
  "name": "dsh-cost-voice",
  "version": "1.2.0",
  "scripts": {
    "test": "node scripts/test-core.mjs && node scripts/test-host.mjs && node scripts/test-client.mjs && node scripts/smoke-host.mjs && node scripts/smoke-client.mjs"
  },
  "description": "大白饭到账语音播报：每轮会话结束默认用内置大白饭声音播报本轮估算花费，也可切换支付宝音色；音频全部内置，无需语音服务。Dabaifan per-turn spend voice announcements for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "gongfpp",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "tts",
    "voice",
    "cost",
    "billing",
    "alipay"
  ],
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0-0",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/voices/**/*.mp3",
    "assets/pricing.json",
    "docs/preview-settings.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.1-0 <0.3.0-0"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "大白饭到账语音播报",
    "summary": "每轮结束默认用内置大白饭到账语音播报本轮估算花费，可切换支付宝音色；优先取 dsh-cost-meter，否则按模型单价估算，无需联网语音服务。",
    "categories": [
      "usage",
      "voice"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {},
    "compatibility": {
      "dsh": ">=0.2.1-0 <0.3.0-0",
      "node": ">=22"
    },
    "permissions": {}
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongfpp/dsh-cost-voice.git"
  },
  "homepage": "https://github.com/gongfpp/dsh-cost-voice#readme",
  "bugs": {
    "url": "https://github.com/gongfpp/dsh-cost-voice/issues"
  }
}

